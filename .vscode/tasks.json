{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Conan: 安装依赖",
      "type": "shell",
      "command": "conan",
      "args": [
        "install", "${workspaceFolder}",
        "--output-folder=${workspaceFolder}\\build",
        "--build=missing",
        "-s", "build_type=Debug",
        "-s", "arch=x86_64", 
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: 配置",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}\\build",
        "-G", "Visual Studio 17 2022",
        "-A", "x64",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}\\build\\conan_toolchain.cmake",
        "-DCMAKE_PREFIX_PATH=${workspaceFolder}\\build" 
      ],
      "group": "build",
      "problemMatcher": [],
      "dependsOn": "Conan: 安装依赖"
    },
    {
      "label": "CMake: 编译",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "${workspaceFolder}\\build",
        "--config", "Debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"],
      "dependsOn": "CMake: 配置"
    }
  ]
}